        "jsCode": "const categoryMap = {};\n\nfor (const item of $input.all()) {\n  const cat = item.json.category;\n  \n  if (!categoryMap[cat]) {\n    categoryMap[cat] = {\n      category: cat,\n      entries: []\n    };\n  }\n  \n  for (const entry of item.json.entries) {\n    categoryMap[cat].entries.push(entry);\n  }\n}\n\n// 更新每个 category 的 count\nconst sections = Object.values(categoryMap).map(section => ({\n  ...section,\n  count: section.entries.length\n}));\n\nreturn [{ json: { sections } }];"

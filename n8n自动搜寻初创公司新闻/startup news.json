        "jsCode": "const seenTitles = new Set();\nconst result = [];\n\nfor (const item of $input.all()) {\n  const dedupedEntries = [];\n\n  for (const entry of item.json.entries) {\n    if (!seenTitles.has(entry.title)) {\n      seenTitles.add(entry.title);\n      dedupedEntries.push(entry);\n    }\n  }\n\n  result.push({\n    json: {\n      ...item.json,\n      entries: dedupedEntries,\n      count: dedupedEntries.length  // 顺便更新 count\n    }\n  });\n}\n\nreturn result;"
